// Mundo WEB: el renderer (React). Lo procesa Vite, un bundler, así que la resolución es "Bundler".
// Sin tipos de Node: si alguien usa `process` o `fs` en la UI, TypeScript tiene que quejarse.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/renderer", "src/shared"],
  "exclude": ["src/renderer/**/*.test.ts"]
}
